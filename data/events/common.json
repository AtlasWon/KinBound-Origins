[
  {
    "id": "waystation_heal",
    "trigger": "interact",
    "actions": [
      {
        "kind": "if",
        "cond": { "kind": "flag", "flag": "ways_met" },
        "then": [
          {
            "kind": "ask",
            "who": "KEEPER",
            "lines": ["Back again, {name}. Shall I have a look at them?"],
            "yes": [
              { "kind": "setRespawn" },
              { "kind": "healParty" },
              { "kind": "wait", "frames": 10 },
              { "kind": "say", "who": "KEEPER", "lines": ["There. Right as rain, the lot of them."] }
            ],
            "no": [
              { "kind": "say", "who": "KEEPER", "lines": ["Suit yourself. I'm here either way."] }
            ]
          }
        ],
        "else": [
          {
            "kind": "say",
            "who": "KEEPER",
            "lines": [
              "Come in, come in. You've the look of a long road about you.",
              "I'm the keeper here. Every waystation has one and we all do the same job.",
              "We put your kin back together, and we don't charge you for it. Ever."
            ]
          },
          { "kind": "setFlag", "flag": "ways_met" },
          {
            "kind": "ask",
            "who": "KEEPER",
            "lines": ["Well then. May I see them?"],
            "yes": [
              { "kind": "setRespawn" },
              { "kind": "healParty" },
              { "kind": "wait", "frames": 10 },
              { "kind": "say", "who": "KEEPER", "lines": ["There. All patched up. Try to keep them that way."] },
              {
                "kind": "say",
                "who": "KEEPER",
                "lines": [
                  "And if it goes badly out there, you'll wake up here. That's the other half of it.",
                  "Nobody tells you that part until they have to. Now you know."
                ]
              }
            ],
            "no": [
              { "kind": "say", "who": "KEEPER", "lines": ["When you're ready, then. The counter doesn't move."] }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "roost_terminal",
    "trigger": "interact",
    "actions": [
      { "kind": "say", "lines": [
        "The Roost terminal hums awake.",
        "Somewhere a long way off, a great many things shuffle and settle."
      ]},
      { "kind": "openStorage" }
    ]
  }
]
