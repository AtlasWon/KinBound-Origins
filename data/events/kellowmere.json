            "...Go and beat Roxen. I will see you at the coast."
          ]},
          { "kind": "move", "who": "km_perrin", "steps": ["down", "down", "down", "down"], "speed": "run" },
          { "kind": "removeNpc", "who": "km_perrin" }
        ]
      }
