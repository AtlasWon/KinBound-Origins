[
  {
    "id": "km_perrin",
    "trigger": "interact",
    "when": { "kind": "not", "of": { "kind": "flag", "flag": "perrin_km_done" } },
    "actions": [
      { "kind": "if",
        "cond": { "kind": "flag", "flag": "starter_sprigling" },
        "then": [{ "kind": "battleTrainer", "trainer": "perrin_km_sprigling" }],
        "else": [
          { "kind": "if",
            "cond": { "kind": "flag", "flag": "starter_cinderpaw" },
            "then": [{ "kind": "battleTrainer", "trainer": "perrin_km_cinderpaw" }],
            "else": [{ "kind": "battleTrainer", "trainer": "perrin_km_rilltail" }]
          }
        ]
      },
      { "kind": "if",
        "cond": { "kind": "var", "var": "last_battle_won", "op": "==", "value": 1 },
        "then": [
          { "kind": "setFlag", "flag": "perrin_km_done" },
          { "kind": "say", "who": "PERRIN", "lines": [
