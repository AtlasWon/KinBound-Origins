      ]
    },
    {
      "kind": "sign",
      "x": 1,
      "y": 6,
      "text": [
        "Bound survey volumes, one per year, back sixty years.",
        "The spine of this year's is uncreased.",
        "Nobody has had time to read what they are writing."
      ]
    },
    {
      "kind": "sign",
      "x": 12,
      "y": 7,
      "text": [
        "A rack of coats on pegs, all Concord grey, all wet.",
        "Whoever wore them came in off the road tonight",
        "and has not been given leave to go home."
      ]
    }
