[
  {
    "id": "hall2_guide",
    "trigger": "interact",
    "actions": [
      {
        "kind": "say",
        "who": "HAND",
        "lines": [
          "Mabry flooded this hall herself. Twenty-two years ago, with a pick and a grudge.",
          "Said a Tide Hall with a dry floor was a lie you tell children."
        ]
      },
      {
        "kind": "if",
        "cond": {
          "kind": "not",
          "of": {
            "kind": "flag",
            "flag": "hall2_hint"
          }
        },
        "then": [
          {
            "kind": "setFlag",
            "flag": "hall2_hint"
          },
          {
            "kind": "say",
            "who": "HAND",
            "lines": [
              "Pale water's shallow. You can walk that.",
              "Dark water's deep, and it will simply refuse you.",
              "The middle lane is dark the whole way up. Everyone tries it once. Everyone."
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "hall2_keeper",
    "trigger": "interact",
    "actions": [
      {
        "kind": "if",
        "cond": {
          "kind": "hasCrest",
          "crest": 3
        },
        "then": [
          {
            "kind": "say",
            "who": "MABRY SULL",
            "lines": [
              "Still dripping on my floor. Good.",
              "Go and ask Ott about the night soundings. He won't tell me, I'm too obviously angry."
            ]
          }
        ],
        "else": [
          {
            "kind": "if",
            "cond": {
              "kind": "not",
              "of": {
                "kind": "hasCrest",
                "crest": 2
              }
            },
            "then": [
              {
                "kind": "say",
                "who": "MABRY SULL",
                "lines": [
                  "Two Crests first. Briarbell, then Roxen down her hole at Stonewake.",
                  "Not a rule I invented. Just one I enforce cheerfully."
                ]
              }
            ],
            "else": [
              {
                "kind": "battleTrainer",
                "trainer": "hall2_mabry"
              },
              {
                "kind": "if",
                "cond": {
                  "kind": "var",
                  "var": "last_battle_won",
                  "op": "==",
                  "value": 1
                },
                "then": [
                  {
                    "kind": "giveCrest",
                    "crest": 3,
                    "name": "Channel Crest"
                  },
                  {
                    "kind": "sfx",
                    "sound": "levelup"
                  },
                  {
                    "kind": "say",
                    "lines": [
                      "You received the CHANNEL CREST."
                    ]
                  },
                  {
                    "kind": "say",
                    "who": "MABRY SULL",
                    "lines": [
                      "Two things about water, {name}, and then you can go drip somewhere else.",
                      "First: shallow is a road, deep is a wall. Telling them apart is most of seamanship."
                    ]
                  },
                  {
                    "kind": "giveArt",
                    "art": "wade"
                  },
                  {
                    "kind": "say",
                    "lines": [
                      "You learned the field art WADE.",
                      "Shallow water out in the world can be crossed now."
                    ]
                  },
                  {
                    "kind": "giveItem",
                    "item": "full_restore",
                    "count": 1
                  },
                  {
                    "kind": "say",
                    "lines": [
                      "Mabry handed over a Full Restore."
                    ]
                  },
                  {
                    "kind": "wait",
                    "frames": 20
                  },
                  {
                    "kind": "say",
                    "who": "MABRY SULL",
                    "lines": [
                      "Second thing. My channel hasn't moved since the first week of spring.",
                      "Not the tide, not the current, not the colour of it. Ninety days of held water."
                    ]
                  },
                  {
                    "kind": "say",
                    "who": "MABRY SULL",
                    "lines": [
                      "The Concord will tell you that's safety. For a town that drowned once, it is.",
                      "But I've watched this channel breathe for forty years and I know a held breath.",
                      "Somebody's going to have to let it out. Try to be somebody who thinks first."
                    ]
                  },
                  {
                    "kind": "setFlag",
                    "flag": "crest_3_taken"
                  },
                  {
                    "kind": "setVar",
                    "var": "act",
                    "value": 3
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
