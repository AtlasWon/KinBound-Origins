[
  {
    "id": "hm_mother",
    "trigger": "interact",
    "actions": [
      {
        "kind": "if",
        "cond": {
          "kind": "flag",
          "flag": "got_starter"
        },
        "then": [
          {
            "kind": "say",
            "who": "MIRA",
            "lines": [
              "Let me look at it. Oh. It is watching me back.",
              "Take care of each other out there. Both of you, and I mean that in both directions."
            ]
          },
          {
            "kind": "if",
            "cond": {
              "kind": "not",
              "of": {
                "kind": "flag",
                "flag": "mom_rest"
              }
            },
            "then": [
              {
                "kind": "setFlag",
                "flag": "mom_rest"
              },
              {
                "kind": "say",
                "who": "MIRA",
                "lines": [
                  "Sit down a minute first, {name}. You look like your father used to."
                ]
              },
              {
                "kind": "healParty"
              },
              {
                "kind": "wait",
                "frames": 10
              },
              {
                "kind": "say",
                "lines": [
                  "Your kin were looked after."
                ]
              }
            ],
            "else": [
              {
                "kind": "ask",
                "lines": [
                  "Do you want to rest before you go?"
                ],
                "yes": [
                  {
                    "kind": "healParty"
                  },
                  {
                    "kind": "wait",
                    "frames": 10
                  },
                  {
                    "kind": "say",
                    "who": "MIRA",
                    "lines": [
                      "Better. Off you go."
                    ]
                  }
                ],
                "no": [
                  {
                    "kind": "say",
                    "who": "MIRA",
                    "lines": [
                      "No, of course not. Go."
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "else": [
          {
            "kind": "say",
            "who": "MIRA",
            "lines": [
              "There you are, {name}. Up before me, which has happened exactly twice in your life.",
              "Both times for the same reason."
            ]
          },
          {
            "kind": "say",
            "who": "MIRA",
            "lines": [
              "You have waited years to get your first kin. Since you were seven and you would not stop asking.",
              "Since your father's journals came back from the coast and he did not.",
              "Well. Professor Sorrell is expecting you, and today you stop waiting."
            ]
          },
          {
            "kind": "choice",
            "lines": [
              "So. Are you ready?"
            ],
            "options": [
              {
                "label": "I'm ready",
                "then": [
                  {
                    "kind": "say",
                    "who": "MIRA",
                    "lines": [
                      "Good. That is the correct answer and I do not believe a word of it.",
                      "Nobody is ready. You go anyway. That is the whole trick."
                    ]
                  }
                ]
              },
              {
                "label": "I'm nervous",
                "then": [
                  {
                    "kind": "say",
                    "who": "MIRA",
                    "lines": [
                      "Good. The ones who are not nervous are the ones who come home in a week.",
                      "Be nervous, and go anyway."
                    ]
                  }
                ]
              },
              {
                "label": "Breakfast first?",
                "then": [
                  {
                    "kind": "say",
                    "who": "MIRA",
                    "lines": [
                      "You have not eaten breakfast on a day like this since you were nine, and you were sick.",
                      "Take these instead and stop looking at me like that."
                    ]
                  },
                  {
                    "kind": "giveItem",
                    "item": "tonic_berry",
                    "count": 2
                  },
                  {
                    "kind": "say",
                    "lines": [
                      "You received 2 Tonic Berries."
                    ]
                  }
                ]
              }
            ]
          },
          {
            "kind": "say",
            "who": "MIRA",
            "lines": [
              "Here. Your father's. It is out of date and half the coast has moved since, but it is a map."
            ]
          },
          {
            "kind": "giveItem",
            "item": "region_map",
            "count": 1
          },
          {
            "kind": "say",
            "lines": [
              "You received the REGION MAP."
            ]
          },
          {
            "kind": "setFlag",
            "flag": "mom_sendoff"
          },
          {
            "kind": "setRespawn",
            "map": "hearthmere_house_player",
            "x": 6,
            "y": 5
          },
          {
            "_note": "CANON, Act 1: 'Mira gives the Tideheart before they leave. It reacts once, and nobody knows why.' The scene itself lives in data/events/common.json as tideheart_gift so that the Stage 4 theft and the Stage 7 ending can reach the same text; this is the only place that calls it. It guards itself on not already holding the thing, so a save that reached Route 1 under the old fallback (tideheart_carried, also in common.json) cannot end up with two.",
            "kind": "call",
            "script": "tideheart_gift"
          },
          {
            "kind": "say",
            "who": "MIRA",
            "lines": [
              "Go on, {name}. Over the bridge, the long low one with the charts in the windows.",
              "And Tarin has been stood on the Ashes' doorstep since dawn pretending not to wait for you."
            ]
          }
        ]
      }
    ]
  }
]
