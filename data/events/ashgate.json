[
  {
    "id": "ag_gate",
    "trigger": "interact",
    "actions": [
      {
        "kind": "if",
        "cond": {
          "kind": "flag",
          "flag": "gate_north_open"
        },
        "then": [
          {
            "kind": "say",
            "who": "SURVEYOR",
            "lines": [
              "Road's open. Mind the stakes. They're mine and I count them."
            ]
          }
        ],
        "else": [
          {
            "kind": "if",
            "cond": {
              "kind": "defeated",
              "trainer": "concord_surveyor_1"
            },
            "then": [
              {
                "kind": "say",
                "who": "SURVEYOR",
                "lines": [
                  "Ilm sent word up about you, {name}. Said you'd turn up here eventually.",
                  "Said you were polite about it, which apparently counts for something."
                ]
              },
              {
                "kind": "wait",
                "frames": 20
              },
              {
                "kind": "say",
                "who": "SURVEYOR",
                "lines": [
                  "Go on, then. Corridor's measured, stakes are in, there's nothing up there.",
                  "That isn't me being cagey. There is genuinely nothing to see.",
                  "That's the problem. Five weeks of nothing and we're told to look again."
                ]
              },
              {
                "kind": "setFlag",
                "flag": "gate_north_open"
              },
              {
                "kind": "sfx",
                "sound": "confirm"
              },
              {
                "kind": "move",
                "who": "ashgate_gate_a",
                "steps": [
                  "left",
                  "left"
                ],
                "speed": "walk"
              },
              {
                "kind": "move",
                "who": "ashgate_gate_b",
                "steps": [
                  "right",
                  "right"
                ],
                "speed": "walk"
              },
              {
                "kind": "removeNpc",
                "who": "ashgate_gate_a"
              },
              {
                "kind": "removeNpc",
                "who": "ashgate_gate_b"
              },
              {
                "kind": "say",
                "lines": [
                  "The way north is open."
                ]
              }
            ],
            "else": [
              {
                "kind": "say",
                "who": "SURVEYOR",
                "lines": [
                  "North road's closed. Survey work.",
                  "It'll be open in a week. It's been a week for five weeks now."
                ]
              },
              {
                "kind": "if",
                "cond": {
                  "kind": "not",
                  "of": {
                    "kind": "flag",
                    "flag": "ag_gate_asked"
                  }
                },
                "then": [
                  {
                    "kind": "setFlag",
                    "flag": "ag_gate_asked"
                  },
                  {
                    "kind": "say",
                    "who": "SURVEYOR",
                    "lines": [
                      "Look. Between us. We're not surveying the road.",
                      "We're surveying what's under it.",
                      "...I didn't say that, you didn't hear it, and I'd like both to stay true."
                    ]
                  },
                  {
                    "kind": "say",
                    "who": "SURVEYOR",
                    "lines": [
                      "Take it up with Ilm. She's on the corridor south of here and she outranks me.",
                      "If you get past her, I'm not going to be the one who stops you."
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]
