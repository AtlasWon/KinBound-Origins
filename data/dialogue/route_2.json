{
  "speakers": {
    "r2_walker": "CARTER",
    "r2_scout": "SCOUT"
  },
  "entries": {
    "r2_walker": [
      {
        "ifFlags": [
          "r2_ruin_open"
        ],
        "lines": [
          "You opened the arch. On the",
          "middle shelf. Don't deny it,",
          "the moss is off the sill."
        ]
      },
      {
        "ifFlags": [
          "r2_thorn_cut"
        ],
        "lines": [
          "You cut it. Just like that.",
          "I've been going round that since",
          "May. ...It was easy, wasn't it."
        ]
      },
      {
        "lines": [
          "Up to the quarry, down to the",
          "port, up to the quarry. Four",
          "hundred times on this road.",
          "The thorn on that spur is new.",
          "One season, straight across the",
          "path. Nothing grows like that."
        ]
      }
    ],
    "r2_scout": [
      "This is a survey. Stay exactly",
      "where you are, please.",
      "You are perfectly placed."
    ]
  }
}
